# 创建该文件的LLM大模型名称：Arena.ai Agent Mode
# 创建时间（北京时间，精确到秒）：2026-05-29 01:18:32 CST

# Ollama 或兼容服务地址
OLLAMA_BASE_URL=http://localhost:11434

# Phase 0 输出目录（相对项目根目录或绝对路径均可）
PHASE0_OUTPUT_ROOT=phase0_outputs

# 若本机模型响应较慢，可适当增大超时秒数
PHASE0_TIMEOUT_SECONDS=180

# Phase 1 运行目录（可选覆盖）
SHOPPING_BROWSER_PROFILE_ROOT=runtime/browser_profiles
SHOPPING_ARTIFACT_ROOT=runtime/artifacts
SHOPPING_CACHE_DB_PATH=runtime/cache/shopping_cache.sqlite3
SHOPPING_SELECTOR_OVERRIDE_PATH=runtime/selector_overrides.yaml
